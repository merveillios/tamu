<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Tes memakai .env biasa (host, user, password MySQL), tetapi database dan setelan di bawah
            dipaksa (force) agar tidak pernah menyentuh database utama. Tests\CreatesApplication
            menolak berjalan bila nama database tidak berakhiran _test (A-15, bukan SQLite).
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_DATABASE" value="sitamu_test" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
        <env name="SESSION_SECURE_COOKIE" value="false" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="SUPERADMIN_EMAIL" value="" force="true"/>
        <env name="SUPERADMIN_PASSWORD" value="" force="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
