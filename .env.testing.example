APP_NAME=SiTamu
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitamu_test
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+07:00

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=4

# Konfigurasi aplikasi (config/sitamu.php)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
GUEST_RATE_LIMIT_MAX=5
GUEST_RATE_LIMIT_WINDOW_MINUTES=10
GOOGLE_VERIFY_RATE_LIMIT_MAX=10
GOOGLE_CLIENT_ID=
EMAIL_VERIFY_TTL_MINUTES=30
POLL_INTERVAL_SECONDS=30
WAITING_ALERT_MINUTES=15
SIGNATURE_MAX_KB=200
GUEST_HISTORY_PER_PAGE=10
CSV_DELIMITER=;
EXPORT_RICH_MAX_ROWS=500
INSTITUTION_NAME="Dinas Perindustrian dan Perdagangan Provinsi Jawa Timur (Disperindag)"
